[% MACRO good_bugtracker BLOCK -%]
&#x1F41E;
[% END -%]
[% MACRO rt_bugtracker BLOCK -%]
<span title="This module uses CPAN RT as its bugtracker."><b>RT</b></span>
[% END -%]
[% MACRO no_bugtracker BLOCK -%]
<span title="This module doesn't define a bugtracker, so MetaCPAN assumes it uses CPAN RT">&#10068;</span>
[% END -%]
[% META author_page = 1 -%]
<script>
window.dashboardSort = { column: "[% sort.column %]", direction: "[% sort.direction %]" };
</script>
    <h1>CPAN Dashboard - [% author.cpan %]</h1>
[% IF fetch_warning -%]
    <p class="alert alert-warning">[% fetch_warning | html %]</p>
[% END -%]
[% IF gathered_at -%]
    <p>Release metadata gathered at [% gathered_at | html %].</p>
[% END -%]
    <p><img alt="[% author.cpan %]" class="gravatar" src="[% (author.gravatar OR '/images/gravatar.png') | html %]"></p>
    <p>A dashboard to see the state of
      <a href="https://metacpan.org/author/[% author.cpan %]">[% author.cpan %]'s CPAN modules</a>.</p>
    <p>You can download this <a href="/[% author.cpan %]/data.json">data as JSON</a>.</p>
    <table class="table table-striped table-hover" id="sort_table">
      <thead>
        <tr>
          <th data-sort-name="name">Name / Repo</th>
          <th>MetaCPAN</th>
          <th>CPANTS</th>
          <th data-sort-name="date">Date</th>
          <th>Bugs</th>
[% IF display_ci.use_gh_actions -%]
          <th>GH Actions</th>
[% END -%]
[% IF display_ci.use_travis -%]
          <th>Travis CI (.org)</th>
[% END -%]
[% IF display_ci.use_travis_com -%]
          <th>Travis CI (.com)</th>
[% END -%]
[% IF display_ci.use_cirrus -%]
          <th>Cirrus CI</th>
[% END -%]
[% IF display_ci.use_appveyor -%]
          <th>Appveyor CI</th>
[% END -%]
[% IF display_ci.use_coveralls -%]
          <th>Coveralls</th>
[% END -%]
[% IF display_ci.use_codecov -%]
          <th>Codecov</th>
[% END -%]
        </tr>
      </thead>
      <tbody>
[% FOREACH m IN modules -%]
        <tr>
          <td>[% IF m.repo %]<a href="[% m.repo | html %]">[% m.dist | html %]</a>[% ELSE %][% m.dist | html %]<br><small><a href="/add/#repository-metadata">Repository link unavailable</a></small>[% END %][% IF m.insecure_repo %] <span title="This distribution has an insecure repository link. This usually means it hasn't been updated for a while." class="warn">&#x26A0;</span>[% END %]</td>
          <td>[% badges.cpan(m) %]</td>
          <td>[% badges.cpants(m) %]</td>
          <td>[% m.date | html %]</td>
          <td>[% IF m.bugtracker %]<a href="[% m.bugtracker | html %]">[% good_bugtracker %]</a>[% ELSE; no_bugtracker; END %]</td>
[%   IF display_ci.use_gh_actions -%]
          <td>[% badges.gh_badges(m, m.ci) %]</td>
[%   END -%]
[%   IF display_ci.use_travis -%]
          <td>[% IF m.ci.use_travis %][% badges.travis(m) %][% END %]</td>
[%   END -%]
[%   IF display_ci.use_travis_com -%]
          <td>[% IF m.ci.use_travis_com %][% badges.travis_com(m) %][% END %]</td>
[%   END -%]
[%   IF display_ci.use_cirrus -%]
          <td>[%- IF m.ci.use_cirrus; FOREACH task_name IN m.ci.cirrus_task_names -%]
            [% badges.cirrus(m, task_name) %][% UNLESS loop.last %]<br>[% END -%]
          [%- END; END %]</td>
[%   END -%]
[%   IF display_ci.use_appveyor -%]
          <td>[% IF m.ci.use_appveyor %][% badges.appveyor(m) %][% END %]</td>
[%   END -%]
[%   IF display_ci.use_coveralls -%]
          <td>[% IF m.ci.use_coveralls %][% badges.coveralls(m, author) %][% END %]</td>
[%   END -%]
[%   IF display_ci.use_codecov -%]
          <td>[% IF m.ci.use_codecov %][% badges.codecov(m) %][% END %]</td>
[%   END -%]
        </tr>
[% END -%]
      </tbody>
    </table>
